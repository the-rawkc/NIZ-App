# NIZ Chat Production Environment Template
# INVARIANT: Zero private identity keys, device keys, or recovery secrets are ever configured here.
# Content-free architecture: backend persistence holds strictly authenticated ciphertext.

# Node Environment & Server Configuration
NODE_ENV=production
PORT=4000
STORAGE_ADAPTER=postgres

# PostgreSQL Connection Configuration
POSTGRES_USER=niz_user
POSTGRES_PASSWORD=replace_with_high_entropy_random_password_here
POSTGRES_DB=niz_chat
DATABASE_URL=postgresql://niz_user:replace_with_high_entropy_random_password_here@postgres:5432/niz_chat

# CORS Configuration (Comma-separated allowed origins)
# Web Client and Admin Console origins should be strictly specified
CORS_ORIGIN=https://chat.yourdomain.com,https://admin.yourdomain.com

# Admin Authentication & MFA
# In production, integrate with WebAuthn/TOTP secrets or corporate SSO provider
ADMIN_MFA_ENFORCED=true

# ==============================================================================
# PRIVATE SUPERADMIN CREDENTIALS (FOR YOUR EXCLUSIVE USE)
# Production Superadmin Access Configuration:
# Set these on your Render / hosting environment variables dashboard.
# Recommended: Set ADMIN_SUPERADMIN_PASSWORD to a high-entropy passphrase.
# ==============================================================================
ADMIN_SUPERADMIN_USERNAME=superadmin
ADMIN_SUPERADMIN_PASSWORD=Niz_SuperAdmin_2026_xK9#vL2!Secure
ADMIN_SUPERADMIN_MFA=948216

# Storage Quotas & Limits
MAX_ATTACHMENT_SIZE_BYTES=26214400 # 25MB standard cap
MAX_DEVICES_FREE=3
MESSAGE_RETENTION_DAYS_FREE=14
