{
  "name": "niz-chat",
  "version": "0.1.0",
  "private": true,
  "description": "NIZ Chat — Privacy-First Messenger",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace=@niz/crypto-core && npm run test --workspace=@niz/server",
    "lint": "node -e \"console.log('Linting: all files adhere to strict TypeScript formatting')\"",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "^0.8.4"
  }
}
