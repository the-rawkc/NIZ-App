# NIZ Chat Environment Variables Template
# Copy to .env for local configuration

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Database Configuration (PostgreSQL)
# For local Docker: postgresql://niz_user:niz_dev_password@localhost:5432/niz_chat
DATABASE_URL=postgresql://niz_user:niz_dev_password@localhost:5432/niz_chat
USE_IN_MEMORY_DB=true

# Storage Engine (Memory or Postgres)
STORAGE_ADAPTER=memory

# Admin API Configuration (Must run on isolated origin in production)
ADMIN_PORT=4001
ADMIN_JWT_SECRET=dev_insecure_admin_jwt_secret_change_in_production_min_32_chars

# Logging & Observability
LOG_LEVEL=info
LOG_CONTENT_REDACTED=true

# Rate Limiting
RATE_LIMIT_MAX_PER_MINUTE=60
